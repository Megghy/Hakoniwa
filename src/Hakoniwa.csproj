<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Hakoniwa</RootNamespace>
    <AssemblyName>Hakoniwa</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(TerrariaDir)\Hakoniwa\</OutputPath>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hexa.NET.ImGui" Version="2.2.9" />
    <PackageReference Include="Hexa.NET.ImGui.Widgets" Version="1.2.18" />
    <PackageReference Include="MonoMod.RuntimeDetour" Version="25.2.2" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.4" />
    <PackageReference Include="System.Text.Json" Version="9.0.7" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.6.1" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Terraria">
      <HintPath>$(TerrariaDir)\Terraria.exe</HintPath>
      <Private>false</Private>
      <Publicize>true</Publicize>
    </Reference>
    <Reference Include="ReLogic">
      <HintPath>$(MSBuildThisFileDirectory)..\libs\ReLogic.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework">
      <HintPath>C:\Windows\Microsoft.NET\assembly\GAC_32\Microsoft.Xna.Framework\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Game">
      <HintPath>C:\Windows\Microsoft.NET\assembly\GAC_32\Microsoft.Xna.Framework.Game\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.Game.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Graphics">
      <HintPath>C:\Windows\Microsoft.NET\assembly\GAC_32\Microsoft.Xna.Framework.Graphics\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.Graphics.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="SetLargeAddressAware" AfterTargets="Build">
    <Exec Command="powershell -NoProfile -File &quot;$(MSBuildThisFileDirectory)set-laa.ps1&quot; -Path &quot;$(TargetPath)&quot;" />
  </Target>

  <Target Name="CopyImGuiX86" AfterTargets="Build">
    <Copy SourceFiles="$(NuGetPackageRoot)\hexa.net.imgui\2.2.9\runtimes\win-x86\native\cimgui.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(NuGetPackageRoot)\hexa.net.imguizmo\2.2.8.4\runtimes\win-x86\native\cimguizmo.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyLauncher" AfterTargets="SetLargeAddressAware">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(TerrariaDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetPath).config" DestinationFolder="$(TerrariaDir)" SkipUnchangedFiles="true" Condition="Exists('$(TargetPath).config')" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(TerrariaDir)" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>

  <Target Name="SweepRootDuplicates" AfterTargets="CopyLauncher;CopyImGuiX86">
    <ItemGroup>
      <_Lib Include="$(OutputPath)*.dll;$(OutputPath)*.pdb" Condition="'%(Filename)' != 'Hakoniwa'" />
    </ItemGroup>
    <Delete Files="@(_Lib-&gt;'$(TerrariaDir)\%(Filename)%(Extension)')" ContinueOnError="true" />
  </Target>
</Project>
